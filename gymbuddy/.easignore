# Kopia .gitignore dla EAS Build, ale BEZ keys.json —
# app.config.js wymaga go do zbudowania konfiguracji, a zawiera
# wylacznie klucze klienckie (i tak trafiaja do bundla aplikacji).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env.txt

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
